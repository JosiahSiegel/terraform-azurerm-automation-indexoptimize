# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
tfplan
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Lock files: consumers of a registry module generate their own lock files,
# so ignore lock files at the root and within examples.
.terraform.lock.hcl
examples/**/.terraform.lock.hcl

# Claude / AI assistant artifacts
.claude/
